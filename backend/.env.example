# Ambiente de desarollo
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lab_crud

# JWT - Cambia este valor en tu entorno real
JWT_SECRET=randomsecretkey
JWT_EXPIRES_IN=2h

# Admin inicial (opcional): si se define, se crea automaticamente al arrancar
# el servidor por primera vez contra una base de datos nueva. Si ya existe un
# usuario con ese email, no se vuelve a crear
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@labcrud.local
ADMIN_PASSWORD=tuclavepersonal123